{
  "name": "supabase-swap",
  "type": "module",
  "private": true,
  "bin": {
    "sbs": "src/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --define SBS_VERSION=\"\\\"dev\\\"\" --outfile dist/sbs",
    "release:local": "scripts/build-release.sh",
    "install-bin": "bun run build && mkdir -p ~/.local/bin && rm -f ~/.local/bin/sbs && cp dist/sbs ~/.local/bin/sbs"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  }
}
